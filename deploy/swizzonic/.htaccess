# Serverregeln für tiefbauleitung.com bei Swizzonic (Apache/LiteSpeed).
# Wird von «npm run build:swizzonic» in dist/ kopiert.

Options -Indexes
# Unsere Startdatei hat Vorrang vor Platzhaltern des Hosters (z. B. index.php)
DirectoryIndex index.html

# Statusdatei des automatischen Hochladens nicht öffentlich ausliefern
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
ErrorDocument 404 /404.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  # Immer https
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
  # www.tiefbauleitung.com → tiefbauleitung.com
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

<IfModule mod_headers.c>
  # HSTS zuerst ohne «preload»; erst ergänzen, wenn https dauerhaft stabil läuft
  Header always set Strict-Transport-Security "max-age=31536000"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
  # Ergänzt die CSP im HTML um Einbettungsschutz (frame-ancestors wirkt nur als HTTP-Header)
  Header always set Content-Security-Policy "frame-ancestors 'none'"
  Header unset X-Powered-By
  # HTML immer frisch prüfen, damit Änderungen sofort sichtbar sind
  <FilesMatch "\.(html|xml|txt)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  <FilesMatch "\.(jpg|jpeg|png|webp|svg|ico|woff2|mp4|webm)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml application/xml application/javascript application/json image/svg+xml
</IfModule>

AddType application/wasm .wasm
AddType font/woff2 .woff2
AddType video/mp4 .mp4
AddType video/webm .webm
