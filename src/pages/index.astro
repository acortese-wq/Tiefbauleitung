        <span class="pos">Pos. 500 · Wissen</span>
        <h2 id="wissen-titel">Aktuelle Fachbeiträge</h2>
        <p>Erfahrungen und Einordnungen zu KI im Bauwesen, Netzinfrastruktur und verantwortungsvoller Digitalisierung.</p>
      </div>
      <div class="raster-3">{artikel.map((a) => <ArtikelKarte artikel={a} />)}</div>
      <div class="btn-reihe mehr-reihe">
        <a class="btn btn-ghost btn-hell" href="/wissen/">Zum Wissensbereich</a>
      </div>
    </div>
  </section>
  )}

  <section class="abschnitt abschluss" aria-labelledby="abschluss-titel">
    <div class="wrap abschluss-raster">
      <figure class="zitat">
        <blockquote><p>«{zitat.text}»</p></blockquote>
        <figcaption>{zitat.quelle} · {zitat.art}</figcaption>
      </figure>
      <div class="abschluss-text">
        <h2 id="abschluss-titel">Ein Projekt, eine Frage, eine Idee?</h2>
        <p>Für Beratung, eine fachliche Zweitmeinung oder den Austausch zu Tiefbau, Netzinfrastruktur und dem praktischen Einsatz von KI.</p>
        <div class="btn-reihe">
          <a class="btn" href="/kontakt/">Kontakt aufnehmen <span class="pfeil" aria-hidden="true">→</span></a>
          <a class="btn btn-ghost" href={person.linkedin} rel="noopener me" target="_blank">LinkedIn<span class="visually-hidden"> (öffnet in neuem Fenster)</span></a>
        </div>
      </div>
    </div>
  </section>
</Basis>

<script>
  // Kennzahlen zählen einmal hoch, sobald sie sichtbar sind. Der Endwert steht im HTML:
  // Suchmaschinen, Besuchende ohne JavaScript und mit reduzierter Bewegung sehen ihn sofort.
  const werte = Array.from(document.querySelectorAll<HTMLElement>('[data-zaehlen]'));
  if (werte.length && 'IntersectionObserver' in window && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const endwert = (el: HTMLElement) => `${el.dataset.ziel}${el.dataset.rest ?? ''}`;
    const zaehle = (el: HTMLElement, ziel: number, rest: string) => {
      const start = performance.now();
      const schritt = (jetzt: number) => {
        if (el.dataset.fertig) return;
        const t = Math.min(1, (jetzt - start) / 1200);
        el.textContent = `${Math.round(ziel * (1 - (1 - t) ** 3))}${rest}`;
        if (t < 1) requestAnimationFrame(schritt);
      };
      requestAnimationFrame(schritt);
    };
    const beobachter = new IntersectionObserver((eintraege) => {
      for (const e of eintraege) {
        if (!e.isIntersecting) continue;
        beobachter.unobserve(e.target);
        const el = e.target as HTMLElement;
        zaehle(el, Number(el.dataset.ziel), el.dataset.rest ?? '');
      }
    }, { threshold: 0.6 });
    for (const el of werte) {
      const [, zahl, rest = ''] = el.textContent?.trim().match(/^(\d+)(.*)$/) ?? [];
      if (!zahl) continue;
      el.dataset.ziel = zahl;
      el.dataset.rest = rest;
      el.textContent = `0${rest}`;
      beobachter.observe(el);
    }
    // Beim Drucken ohne vorheriges Scrollen sollen nicht «0» erscheinen
    addEventListener('beforeprint', () => {
      beobachter.disconnect();
      for (const el of werte) if (el.dataset.ziel) { el.dataset.fertig = 'ja'; el.textContent = endwert(el); }
    });
  }
</script>

<script>
  // Video im Bildband: spielt stumm, sobald es sichtbar ist, und hält an, wenn es aus dem Bild scrollt.
  // Bei «Bewegung reduzieren» oder Datensparmodus startet es nur auf Knopfdruck. Ohne JavaScript bleiben die Browser-Bedienelemente.
  const figur = document.querySelector<HTMLElement>('[data-weg-video]');
  const video = figur?.querySelector<HTMLVideoElement>('[data-video]');
  const knopf = figur?.querySelector<HTMLButtonElement>('[data-video-knopf]');
  if (figur && video && knopf) {
    const netz = (navigator as Navigator & { connection?: { saveData?: boolean } }).connection;
    let angehalten = matchMedia('(prefers-reduced-motion: reduce)').matches || netz?.saveData === true;
    const label = knopf.querySelector<HTMLElement>('[data-video-label]')!;
    const zeige = () => {
      knopf.classList.toggle('spielt', !video.paused);
      label.textContent = video.paused ? 'Video abspielen' : 'Video anhalten';
    };
    const spiele = () => { video.play().catch(() => {}).finally(zeige); };
    video.controls = false;
    knopf.hidden = false;
    video.addEventListener('play', zeige);
    video.addEventListener('pause', zeige);
    knopf.addEventListener('click', () => {
      angehalten = !video.paused;
      if (angehalten) video.pause();
      else spiele();
    });
    new IntersectionObserver(([e]) => {
      if (e.isIntersecting && !angehalten) spiele();
      else if (!e.isIntersecting && !video.paused) video.pause();
    }, { threshold: 0.4 }).observe(video);
    zeige();
  }
</script>

