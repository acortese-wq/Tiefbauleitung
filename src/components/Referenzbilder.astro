---
// Bildband der Referenzobjekte. Zeigt nur Objekte mit hinterlegtem Foto; ohne Fotos erscheint nichts.
import { getCollection } from 'astro:content';

interface Props { filter?: string; titel?: string; /** Höchstens so viele Bilder (Startseite: eine Reihe) */ anzahl?: number; }
const { filter, titel = 'Referenzobjekte im Bild', anzahl } = Astro.props;
const filterWerte = filter ? filter.split(',').map((f) => f.trim()) : [];
const mitBild = (await getCollection('referenzen'))
  .map((r) => r.data)
  .filter((r) => r.bild && (!filterWerte.length || r.fachgebiete.some((g) => filterWerte.includes(g))))
  .slice(0, anzahl);
// Gleicher Fotonachweis für alle und ohne Lizenz: einmal unter dem Bildband statt auf jeder Karte
const nachweise = [...new Set(mitBild.map((r) => r.bildNachweis))];
const gemeinsamerNachweis = nachweise.length === 1 && !mitBild.some((r) => r.bildLizenz) ? nachweise[0] : undefined;
// Spalten so wählen, dass keine Reihe mit einem einzelnen Bild entsteht
const spalten = mitBild.length % 4 === 0 ? 4 : mitBild.length % 3 === 0 ? 3 : 4;
---
{mitBild.length > 0 && (
  <section class:list={['bildband', `bildband-${spalten}`]} aria-label={titel}>
    <h3 class="bildband-titel">{titel}</h3>
    <ul>
      {mitBild.map((r) => (
        <li>
          <figure>
            <picture>
              <source srcset={`/bilder/referenzen/${r.bild}.webp`} type="image/webp" />
              <img src={`/bilder/referenzen/${r.bild}.jpg`} alt={r.bildAlt} loading="lazy" decoding="async" width="800" height="600" />
            </picture>
            <figcaption>
              <strong>{r.name}</strong>
              <span>{r.rolle} · {r.zeitraum}</span>
              {r.fallstudie && <a href={`/projekte/${r.fallstudie}/`}>Infos<span class="visually-hidden"> zu {r.name}</span> <span class="pfeil" aria-hidden="true">→</span></a>}
              {!gemeinsamerNachweis && <small>Foto: {r.bildNachweis}{r.bildLizenz && <> · <a href={r.bildLizenz} rel="license noopener" target="_blank">Lizenz<span class="visually-hidden"> (öffnet in neuem Fenster)</span></a></>}</small>}
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
    {gemeinsamerNachweis && <p class="bildband-nachweis">Fotos: {gemeinsamerNachweis}</p>}
  </section>
)}

<style>
  .bildband { margin-bottom: var(--raum-7); }
  .bildband-titel { font-size: 1.5rem; margin-bottom: var(--raum-3); }
  .bildband ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--raum-4); }
  .bildband-3 ul { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  @media (max-width: 960px) { .bildband ul, .bildband-3 ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .bildband ul, .bildband-3 ul { grid-template-columns: minmax(0, 1fr); } }
  .bildband-nachweis { margin-top: var(--raum-3); font: 0.75rem var(--f-mono); color: var(--text-ruhig); }
  .bildband figure { margin: 0; border: 1px solid var(--linie); border-radius: var(--radius); overflow: hidden; background: var(--tiefe); height: 100%; display: flex; flex-direction: column; }
  .bildband picture { display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--panel); }
  .bildband img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform var(--dauer-lang) var(--kurve); }
  .bildband figure:hover img { transform: scale(1.03); }
  .bildband figcaption { display: grid; gap: var(--raum-1); padding: var(--raum-3) var(--raum-4) var(--raum-4); }
  .bildband figcaption span { color: var(--text-ruhig); font-size: 0.92rem; }
  /* Unsichtbar vergrösserte Klickfläche (44 px hoch), der Fokusrahmen bleibt eng am Text */
  .bildband figcaption a { position: relative; font-weight: 600; font-size: 0.9rem; text-decoration: none; }
  .bildband figcaption a:not(small a)::after { content: ''; position: absolute; inset: -11px -6px; }
  .bildband figcaption a:hover { text-decoration: underline; }
  .bildband figcaption small { font-family: var(--f-mono); font-size: 0.75rem; color: var(--text-ruhig); }
  .bildband figcaption small a { color: var(--eis); }
</style>
