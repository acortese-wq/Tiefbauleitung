---
// KI-Radar: täglich im Build aktualisierte Liste neuer Modelle (siehe scripts/ki-radar.mjs). Keine Anfragen beim Seitenaufruf.
// Daten älter als 14 Tage werden nicht angezeigt. Ranglisten werden verlinkt, nicht nachgebaut.
import radar from '../data/ki-radar.json';

interface Neu { name: string; anbieter: string; datum: string; kontext: number | null }
const r = radar as { abgerufen?: string; neu?: { quelle: string; stand?: string; modelle: Neu[] } };
const MAX_ALTER_TAGE = 14;
const frisch = (iso?: string) => !!iso && (Date.now() - Date.parse(`${iso}T00:00:00Z`)) / 86400000 <= MAX_ALTER_TAGE;
const datum = (iso?: string | null) => (iso ? new Date(`${iso}T12:00:00Z`).toLocaleDateString('de-CH', { day: 'numeric', month: 'long', year: 'numeric' }) : 'unbekannt');
const neu = frisch(r.neu?.stand) && r.neu?.modelle.length ? r.neu : undefined;
const kontext = (n: number | null) => (n ? `${Math.round(n / 1000).toLocaleString('de-CH')}k Token Kontext` : '');
const ranglisten = [
  { href: 'https://openrouter.ai/rankings', titel: 'OpenRouter Rankings', text: 'Meistgenutzte Modelle nach verarbeiteten Datenmengen, wöchentlich und monatlich.' },
  { href: 'https://lmarena.ai/leaderboard', titel: 'LMArena Leaderboard', text: 'Rangliste aus Blindvergleichen: Welche Antwort gefällt den Nutzenden besser?' },
  { href: 'https://artificialanalysis.ai/leaderboards/models', titel: 'Artificial Analysis', text: 'Unabhängige Tests zu Qualität, Geschwindigkeit und Preis.' },
];
---
<section class="abschnitt radar" aria-labelledby="radar-titel">
  <div class="wrap">
    <div class="abschnitt-kopf">
      <p class="label label-eis">KI-Radar{neu && ` · Stand ${datum(neu.stand)}`}</p>
      <h2 id="radar-titel">Was es Neues bei den Sprachmodellen gibt</h2>
      <p>Die neuesten Modelle, täglich aktualisiert aus der öffentlichen Modellliste von OpenRouter, einer Plattform, die Modelle vieler Anbieter bündelt. Für Ranglisten verlinken wir die Originalquellen, statt veraltete oder ungeprüfte Zahlen zu zeigen.</p>
    </div>

    <div class="radar-raster">
      {neu ? (
        <div class="radar-karte" data-radar>
          <h3>Neu verfügbar</h3>
          <ol class="radar-liste">
            {neu.modelle.map((m, i) => (
              <li>
                <span class="radar-rang">{i + 1}</span>
                <span class="radar-name"><strong>{m.name}</strong><small>{m.anbieter} · {datum(m.datum)}{m.kontext ? ` · ${kontext(m.kontext)}` : ''}</small></span>
              </li>
            ))}
          </ol>
          <p class="radar-quelle">Quelle: <a href={neu.quelle} rel="noopener" target="_blank">OpenRouter<span class="visually-hidden"> (öffnet in neuem Fenster)</span></a>, öffentliche Modellliste, Stand {datum(neu.stand)}.</p>
        </div>
      ) : (
        <div class="radar-karte" data-radar-leer>
          <h3>Liste wird aktualisiert</h3>
          <p class="radar-quelle">Die Liste wird bei jedem täglichen Neuaufbau der Webseite frisch geladen. Ist die Quelle nicht erreichbar, zeigen wir lieber nichts als veraltete Angaben.</p>
        </div>
      )}

      <div class="radar-karte">
        <h3>Aktuelle Ranglisten</h3>
        <ul class="radar-neu">
          {ranglisten.map((l) => (
            <li><a href={l.href} rel="noopener" target="_blank"><strong>{l.titel}</strong><span class="visually-hidden"> (öffnet in neuem Fenster)</span></a><small>{l.text}</small></li>
          ))}
        </ul>
      </div>

      <div class="radar-karte radar-tipp">
        <h3>Was heisst das für die Bauleitung?</h3>
        <ul>
          <li>Für Offertprüfung und Protokolle reichen die führenden Modelle aller grossen Anbieter. Wichtiger als der Rang sind Datenschutz und eine vom Arbeitgeber freigegebene Lösung.</li>
          <li>Für lange Dokumente zählt das Kontextfenster: Wie viele Seiten verarbeitet das Modell auf einmal?</li>
          <li>Für Berechnungen nie dem Modell vertrauen, sondern rechnen lassen: Tabellen hier im KI-Labor prüfen oder ein Werkzeug verwenden.</li>
        </ul>
      </div>
    </div>
  </div>
</section>


<style>
  .radar-raster { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 20px; align-items: start; }
  .radar-karte { border: 1px solid var(--linie); border-radius: var(--radius); background: var(--tiefe); padding: 18px 20px; }
  .radar-karte h3 { font-size: 1.15rem; margin-bottom: 10px; }
  .radar-tipp { grid-column: 2; }
  .radar-raster > .radar-karte:first-child { grid-row: span 2; }
  .radar-liste { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .radar-liste li { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 10px; align-items: center; padding: 4px 0; border-bottom: 1px solid var(--linie); }
  .radar-rang { font: 600 0.85rem var(--f-mono); color: var(--eis); text-align: right; }
  .radar-name { display: grid; min-width: 0; }
  .radar-name strong { font-weight: 600; font-size: 0.95rem; overflow-wrap: anywhere; }
  .radar-name small, .radar-neu small { color: var(--text-ruhig); font-size: 0.8rem; }
  .radar-neu { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .radar-neu li { display: grid; gap: 2px; }
  .radar-neu a { text-decoration: none; }
  .radar-neu a:hover strong { text-decoration: underline; }
  .radar-tipp ul { margin: 0; padding-left: 1.1em; display: grid; gap: 8px; color: var(--text-ruhig); font-size: max(0.95rem, var(--min-karte)); }
  .radar-quelle { margin-top: 12px; font-size: max(0.82rem, var(--min-hilfe)); color: var(--text-ruhig); }
  .radar-quelle strong { color: var(--signal); font-weight: 600; }
  @media (max-width: 900px) {
    .radar-raster { grid-template-columns: 1fr; }
    .radar-tipp { grid-column: auto; }
    .radar-raster > .radar-karte:first-child { grid-row: auto; }
  }
</style>
