---
// KI-Radar: täglich im Build aktualisierte Daten (siehe scripts/ki-radar.mjs). Keine Anfragen beim Seitenaufruf.
// Veraltete Daten (älter als 14 Tage) werden nicht angezeigt.
import radar from '../data/ki-radar.json';

interface Eintrag { rang: number; modell: string; anbieter: string }
interface Neu { name: string; anbieter: string; datum: string; kontext: number | null }
const r = radar as {
  abgerufen?: string;
  nutzung?: { quelle: string; stand: string; kategorien: { gesamt?: Eintrag[]; programmieren?: Eintrag[] } };
  neu?: { quelle: string; stand?: string; modelle: Neu[] };
};
const MAX_ALTER_TAGE = 14;
const frisch = (iso?: string) => !!iso && (Date.now() - Date.parse(`${iso}T00:00:00Z`)) / 86400000 <= MAX_ALTER_TAGE;
const datum = (iso?: string | null) => (iso ? new Date(`${iso}T12:00:00Z`).toLocaleDateString('de-CH', { day: 'numeric', month: 'long', year: 'numeric' }) : 'unbekannt');
const nutzung = frisch(r.nutzung?.stand) ? r.nutzung : undefined;
const neu = frisch(r.neu?.stand ?? r.abgerufen) && r.neu?.modelle.length ? r.neu : undefined;
const reiter = ([
  { id: 'gesamt', label: 'Gesamt' },
  { id: 'programmieren', label: 'Programmieren' },
] as const).filter((t) => (nutzung?.kategorien[t.id]?.length ?? 0) > 0);
const kontext = (n: number | null) => (n ? `${Math.round(n / 1000).toLocaleString('de-CH')}k Kontext` : '');
---
<section class="abschnitt radar" aria-labelledby="radar-titel">
  <div class="wrap">
    <div class="abschnitt-kopf">
      <p class="label label-eis">KI-Radar{nutzung && ` · Stand ${datum(nutzung.stand)}`}</p>
      <h2 id="radar-titel">Welche Sprachmodelle gerade am meisten genutzt werden</h2>
      <p>Rangliste der meistgenutzten Modelle der letzten Woche, gemessen an den verarbeiteten Datenmengen (Tokens) auf der Plattform OpenRouter, die Modelle vieler Anbieter bündelt. Das zeigt, was in der Praxis eingesetzt wird, nicht, was für Ihre Aufgabe am besten passt.</p>
    </div>

    <div class="radar-raster">
      {nutzung && reiter.length > 0 ? (
        <div class="radar-karte" data-radar>
          {reiter.length > 1 && (
            <div class="radar-reiter" role="tablist" aria-label="Kategorie">
              {reiter.map((t, i) => (
                <button type="button" role="tab" id={`radar-tab-${t.id}`} aria-controls={`radar-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1}>{t.label}</button>
              ))}
            </div>
          )}
          {reiter.map((t, i) => (
            <div class="radar-panel" id={`radar-${t.id}`} role="tabpanel" aria-labelledby={reiter.length > 1 ? `radar-tab-${t.id}` : undefined} aria-label={reiter.length > 1 ? undefined : t.label} hidden={i !== 0}>
              <ol class="radar-liste">
                {(nutzung.kategorien[t.id] ?? []).map((e) => (
                  <li>
                    <span class="radar-rang">{e.rang}</span>
                    <span class="radar-name"><strong>{e.modell}</strong><small>{e.anbieter}</small></span>
                  </li>
                ))}
              </ol>
            </div>
          ))}
          <p class="radar-quelle">
            Quelle: <a href={nutzung.quelle} rel="noopener" target="_blank">OpenRouter Rankings<span class="visually-hidden"> (öffnet in neuem Fenster)</span></a>, Stand {datum(nutzung.stand)}, täglich aktualisiert.
          </p>
        </div>
      ) : (
        <div class="radar-karte" data-radar-leer>
          <h3>Rangliste wird aktualisiert</h3>
          <p class="radar-quelle">Die Rangliste wird bei jedem täglichen Neuaufbau der Webseite frisch geladen. Ist die Quelle nicht erreichbar, zeigen wir lieber nichts als veraltete Zahlen. Die aktuelle Rangliste finden Sie direkt bei <a href="https://openrouter.ai/rankings" rel="noopener" target="_blank">OpenRouter<span class="visually-hidden"> (öffnet in neuem Fenster)</span></a>.</p>
        </div>
      )}

      {neu && (
        <div class="radar-karte">
          <h3>Neu verfügbar</h3>
          <ul class="radar-neu">
            {neu.modelle.map((m) => (
              <li>
                <strong>{m.name}</strong>
                <small>{m.anbieter} · {datum(m.datum)}{m.kontext ? ` · ${kontext(m.kontext)}` : ''}</small>
              </li>
            ))}
          </ul>
          <p class="radar-quelle">Quelle: <a href={neu.quelle} rel="noopener" target="_blank">OpenRouter<span class="visually-hidden"> (öffnet in neuem Fenster)</span></a>, öffentliche Modellliste.</p>
        </div>
      )}

      <div class="radar-karte radar-tipp">
        <h3>Was heisst das für die Bauleitung?</h3>
        <ul>
          <li>Für Offertprüfung und Protokolle reichen die führenden Modelle aller grossen Anbieter. Wichtiger als der Rang sind Datenschutz und eine vom Arbeitgeber freigegebene Lösung.</li>
          <li>Für lange Dokumente zählt das Kontextfenster: Wie viele Seiten verarbeitet das Modell auf einmal?</li>
          <li>Für Berechnungen nie dem Modell vertrauen, sondern rechnen lassen: Tabellen hier im KI-Labor prüfen oder ein Werkzeug verwenden.</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<script>
  for (const karte of document.querySelectorAll<HTMLElement>('[data-radar]')) {
    const tabs = Array.from(karte.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const zeige = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const aktiv = t === tab;
        t.setAttribute('aria-selected', String(aktiv));
        t.tabIndex = aktiv ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !aktiv;
      }
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => zeige(t));
      t.addEventListener('keydown', (e) => {
        const n = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!n) return;
        const ziel = tabs[(i + n + tabs.length) % tabs.length];
        zeige(ziel);
        ziel.focus();
      });
    });
  }
</script>

<style>
  .radar-raster { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 20px; align-items: start; }
  .radar-karte { border: 1px solid var(--linie); border-radius: var(--radius); background: var(--tiefe); padding: 18px 20px; }
  .radar-karte h3 { font-size: 1.15rem; margin-bottom: 10px; }
  .radar-tipp { grid-column: 2; }
  .radar-raster > .radar-karte:first-child { grid-row: span 2; }
  .radar-reiter { display: flex; gap: 6px; margin-bottom: 12px; flex-wrap: wrap; }
  .radar-reiter button {
    font: 500 0.82rem var(--f-mono); min-height: 40px; padding: 8px 14px; border-radius: 999px; cursor: pointer;
    border: 1px solid var(--linie-hell); background: transparent; color: var(--text);
  }
  .radar-reiter button[aria-selected='true'] { background: var(--eis); border-color: var(--eis); color: var(--nacht); }
  .radar-reiter button:focus-visible { outline: 2px solid var(--eis); outline-offset: 2px; }
  .radar-liste { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .radar-panel[hidden] { display: none; }
  .radar-liste li { display: grid; grid-template-columns: 28px minmax(0, 1fr); gap: 10px; align-items: center; padding: 4px 0; border-bottom: 1px solid var(--linie); }
  .radar-rang { font: 600 0.85rem var(--f-mono); color: var(--eis); text-align: right; }
  .radar-name { display: grid; min-width: 0; }
  .radar-name strong { font-weight: 600; font-size: 0.95rem; overflow-wrap: anywhere; }
  .radar-name small, .radar-neu small { color: var(--text-ruhig); font-size: 0.8rem; }
  .radar-neu { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .radar-neu li { display: grid; }
  .radar-tipp ul { margin: 0; padding-left: 1.1em; display: grid; gap: 8px; color: var(--text-ruhig); font-size: 0.95rem; }
  .radar-quelle { margin-top: 12px; font-size: 0.82rem; color: var(--text-ruhig); }
  .radar-quelle strong { color: var(--signal); font-weight: 600; }
  @media (max-width: 900px) {
    .radar-raster { grid-template-columns: 1fr; }
    .radar-tipp { grid-column: auto; }
    .radar-raster > .radar-karte:first-child { grid-row: auto; }
  }
</style>
