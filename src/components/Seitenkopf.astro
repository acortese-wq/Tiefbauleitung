---
interface Props {
  titel: string;
  lead?: string;
  pos?: string;
  krumen?: { name: string; href?: string }[];
  /** Optionales Kopfbild aus public/bilder/<ordner>/ (Dateien von npm run bilder). */
  bild?: { ordner: string; name: string; alt: string; hinweis?: string };
}
const { titel, lead, pos, krumen = [], bild } = Astro.props;
const pfad = bild && `/bilder/${bild.ordner}/${bild.name}`;
// Ohne Bilddatei kann eine Zeichnung (SVG) über den Slot «bild» übergeben werden.
const illustration = !bild && Astro.slots.has('bild');
---
<section class:list={['seitenkopf', { 'mit-bild': bild || illustration }]}>
  {illustration && (
    <div class="kopf-bild kopf-illustration"><slot name="bild" /></div>
  )}
  {bild && (
    <figure class="kopf-bild">
      <picture>
        <source type="image/webp" srcset={`${pfad}-800.webp 800w, ${pfad}-1600.webp 1600w`} sizes="(min-width: 900px) 55vw, calc(100vw - 32px)" />
        <img src={`${pfad}.jpg`} alt={bild.alt} width="1600" height="1067" decoding="async" fetchpriority="high" />
      </picture>
      {bild.hinweis && <figcaption>{bild.hinweis}</figcaption>}
    </figure>
  )}
  <div class="wrap">
    {krumen.length > 0 && (
      <nav class="brotkrumen" aria-label="Brotkrumen">
        <ol>
          <li><a href="/">Start</a></li>
          {krumen.map((k) => (
            <li>{k.href ? <a href={k.href}>{k.name}</a> : <span aria-current="page">{k.name}</span>}</li>
          ))}
        </ol>
      </nav>
    )}
    {pos && <span class="pos">{pos}</span>}
    <h1 class="einblenden">{titel}</h1>
    {lead && <p class="lead einblenden einblenden-2">{lead}</p>}
    <slot />
  </div>
</section>

<style>
  /* Mobil: Bild als Band unter dem Text. Desktop: rechte Hälfte, nach links und unten in den Hintergrund auslaufend. */
  .kopf-bild { margin: 0; position: relative; }
  .kopf-bild img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 65% 50%; }
  .kopf-bild figcaption {
    position: absolute; right: 10px; bottom: 8px; font-family: var(--f-mono); font-size: 0.68rem;
    color: var(--text-ruhig); background: rgb(10 15 20 / 0.72); padding: 2px 6px; border-radius: 3px;
  }
  .mit-bild { display: flex; flex-direction: column-reverse; }
  .mit-bild .kopf-bild { margin: 24px 16px 0; aspect-ratio: 16 / 9; border: 1px solid var(--linie); border-radius: var(--radius); overflow: hidden; }
  .mit-bild .kopf-illustration { aspect-ratio: 3 / 2; border: 0; border-radius: 0; overflow: visible; }
  @media (min-width: 900px) {
    .mit-bild { display: block; }
    .mit-bild .kopf-bild {
      position: absolute; inset: 0 0 0 auto; width: 55%; margin: 0; aspect-ratio: auto; border: 0; border-radius: 0;
    }
    /* Maske nur auf dem Bild, damit der Hinweis lesbar bleibt */
    .mit-bild .kopf-bild picture {
      display: block; height: 100%;
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 45%), linear-gradient(0deg, transparent 0%, #000 30%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 45%), linear-gradient(0deg, transparent 0%, #000 30%);
      -webkit-mask-composite: source-in; mask-composite: intersect;
    }
    .mit-bild .kopf-bild figcaption { bottom: 14px; right: 16px; }
    /* Zeichnung: nur links weich auslaufen, Planbeschriftung unten bleibt lesbar */
    .mit-bild .kopf-illustration { padding: 20px 24px 12px 0; }
    .mit-bild .kopf-illustration > :global(svg) {
      -webkit-mask-image: linear-gradient(90deg, transparent 0%, #000 32%);
      mask-image: linear-gradient(90deg, transparent 0%, #000 32%);
    }
  }
</style>
