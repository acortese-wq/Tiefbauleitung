---
import { getCollection } from 'astro:content';
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import ProjektKarte from '../../components/ProjektKarte.astro';
import Referenzliste from '../../components/Referenzliste.astro';
import Referenzbilder from '../../components/Referenzbilder.astro';
import Werkzeugkasten from '../../components/Werkzeugkasten.astro';
import { werkzeuge } from '../../data/werkzeuge';
import { sichtbareProjekte } from '../../lib/content';
import { breadcrumbJsonLd } from '../../lib/seo';

const projekte = await sichtbareProjekte();
const anzahl = (await getCollection('referenzen')).length;
const site = Astro.site!;
---
<Basis
  title="Projekte und Fallstudien"
  description={`Fallstudien, ${werkzeuge.length} selbst entwickelte Werkzeuge für Offerte, Kosten und Abrechnung sowie ${anzahl} belegte Referenzprojekte aus dem Tiefbau.`}
  jsonLd={[breadcrumbJsonLd([{ name: 'Start', url: site.href }, { name: 'Projekte', url: new URL('/projekte/', site).href }])]}
>
  <Seitenkopf
    titel="Projekte"
    pos="Pos. 300"
    lead="Fallstudien zu eigenen Projekten und Konzepten, ein Werkzeugkasten mit selbst entwickelten Werkzeugen und eine belegte Liste beruflicher Referenzprojekte."
    krumen={[{ name: 'Projekte' }]}
  />

  <section class="abschnitt" aria-labelledby="fs-titel">
    <div class="wrap">
      <div class="abschnitt-kopf">
        <span class="pos">Fallstudien</span>
        <h2 id="fs-titel">Eigene Projekte und Konzepte</h2>
      </div>
      <dl class="legende">
        <div><dt><span class="badge badge-persoenlich">Persönliches Projekt</span></dt><dd>Privat entwickelt und genutzt</dd></div>
        <div><dt><span class="badge badge-konzept">Konzept</span></dt><dd>Methodik ohne Kundendaten oder Ergebnisse</dd></div>
        <div><dt><span class="badge badge-beruflich">Berufliche Erfahrung</span></dt><dd>Belegt durch Lebenslauf und Zeugnisse</dd></div>
      </dl>
      <div class="raster-3">{projekte.map((p) => <ProjektKarte projekt={p} />)}</div>
    </div>
  </section>

  <section class="abschnitt" id="werkzeugkasten" aria-labelledby="wk-titel">
    <div class="wrap">
      <div class="abschnitt-kopf">
        <span class="pos">Werkzeugkasten</span>
        <h2 id="wk-titel">{werkzeuge.length} eigene Werkzeuge aus der Praxis</h2>
        <p>Selbst entwickelt, mit KI-Unterstützung (Claude), in Excel, HTML und Copilot Studio. Genannt sind Name und Zweck; Daten, Kunden und Ergebnisse aus Projekten bleiben vertraulich.</p>
      </div>
      <Werkzeugkasten />
    </div>
  </section>

  <section class="abschnitt band-dunkel" aria-labelledby="ref-titel">
    <div class="wrap">
      <div class="abschnitt-kopf">
        <span class="badge badge-beruflich">Berufliche Erfahrung</span>
        <h2 id="ref-titel">{anzahl} Referenzprojekte 2006–2025</h2>
        <p>Aus Lebenslauf und Arbeitszeugnissen. Angegeben sind Arbeitgeber, Bauherr (soweit bekannt) und die eigene Rolle. Projekte im aktuellen Arbeitsverhältnis sind bewusst nicht aufgeführt.</p>
      </div>
      <Referenzbilder />
      <Referenzliste />
    </div>
  </section>
</Basis>

<style>
  .legende { display: flex; flex-wrap: wrap; gap: 12px 28px; margin: 0 0 24px; }
  .legende div { display: flex; align-items: center; gap: 10px; }
  .legende dd { margin: 0; color: var(--text-ruhig); font-size: 0.92rem; }
</style>
