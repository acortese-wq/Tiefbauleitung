---
import Kernaussage from '../../components/Kernaussage.astro';
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import { einsatzfelder } from '../../data/einsatzfelder';
import { prompts } from '../../data/prompts';
import radar from '../../data/ki-radar.json';

const n = (radar as { neu?: { stand?: string; modelle: { name: string }[] } }).neu;
const neuestes = n?.stand && (Date.now() - Date.parse(`${n.stand}T00:00:00Z`)) / 86400000 <= 14 ? n.modelle[0]?.name : undefined;
const bereiche = [
  {
    href: '/ki-labor/werkbank/',
    titel: 'Prompt-Werkbank',
    text: `${prompts.length} ausführliche Vorlagen für LV-Prüfung, Offertvergleich, Nachträge, Ausmass, Protokolle, Werkleitungen und Glasfaserausbau. Links eintragen, Prompt passt sich an, Tabellen werden direkt geprüft.`,
    tag: 'rechnet LV, Offerten, Ausmass',
  },
  {
    href: '/ki-labor/nutzenrechner/',
    titel: 'Nutzenrechner',
    text: 'Was wiederkehrende Handarbeit kostet und wann sich eine Automatisierung zurückzahlt: FTE-Methode und Simple Payback in Franken, druckbar als Business Case.',
    tag: 'Schieberegler, CHF, drucken',
  },
  {
    href: '/ki-labor/radar/',
    titel: 'KI-Radar',
    text: `Die neuesten Sprachmodelle, täglich aktualisiert, mit Links zu den aktuellen Ranglisten.${neuestes ? ` Zuletzt neu: ${neuestes}.` : ''}`,
    tag: 'täglich aktualisiert',
  },
];
---
<Basis
  title="KI-Labor: KI in der Bauleitung ausprobieren"
  description="Prompt-Werkbank, Nutzenrechner und KI-Radar für Tiefbau und Netzbau. Alles läuft im Browser, ohne Konto und ohne Datenübermittlung."
>
  <Seitenkopf
    titel="KI-Labor"
    lead="KI in der Bauleitung zum Ausprobieren: Prompts für den Alltag, ein Rechner für den Business Case und ein Blick auf die aktuellen Sprachmodelle. Alles läuft in Ihrem Browser, ohne Konto und ohne Datenübermittlung."
    krumen={[{ name: 'KI-Labor' }]}
  />

  <div class="ka-abstand"></div>
  <Kernaussage klein />

  <section class="abschnitt" aria-labelledby="bereiche-titel">
    <div class="wrap">
      <h2 id="bereiche-titel" class="visually-hidden">Bereiche des KI-Labors</h2>
      <div class="raster-3">
        {bereiche.map((b) => (
          <a class="karte labor-karte" href={b.href}>
            <span class="chip">{b.tag}</span>
            <h3>{b.titel}</h3>
            <p>{b.text}</p>
            <span class="mehr">Öffnen →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="felder-titel">
    <div class="wrap">
      <div class="abschnitt-kopf">
        <p class="label">Überblick</p>
        <h2 id="felder-titel">10 Dinge, die KI in der Bauleitung heute leisten kann</h2>
        <p>Aus meiner Praxis im Tiefbau und Netzbau, unabhängig vom Anbieter. Überall gilt: Die KI bereitet vor, die Fachperson entscheidet.</p>
      </div>
      <ol class="felder">
        {einsatzfelder.map((f, i) => (
          <li class="feld">
            <span class="feld-nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div class="feld-karte">
              <h3>{f.titel}</h3>
              <p>{f.text}</p>
              <ul class="feld-tags" aria-label="Stichworte">{f.tags.map((t) => <li>{t}</li>)}</ul>
              {f.link && <a class="feld-link" href={f.link.href}>{f.link.label}<span class="visually-hidden">: {f.titel}</span> →</a>}
            </div>
          </li>
        ))}
      </ol>
      <p class="felder-grenze"><strong>Was KI nicht kann:</strong> Verantwortung übernehmen, die Baustelle sehen, einen Vertrag verbindlich auslegen oder einen Vergabeentscheid treffen.</p>
    </div>
  </section>
</Basis>

<style>
  .ka-abstand { height: clamp(28px, 4vw, 48px); }
  .labor-karte { display: grid; gap: 10px; align-content: start; text-decoration: none; color: inherit; }
  .labor-karte .chip { justify-self: start; }
  .labor-karte p { color: var(--text-ruhig); }
  .labor-karte .mehr { font-weight: 600; color: var(--eis); margin-top: auto; }
  /* Zehn Einsatzfelder */
  .felder { list-style: none; margin: 0; padding: 0; position: relative; display: grid; gap: 18px; }
  .felder::before {
    content: ''; position: absolute; top: 8px; bottom: 8px; left: 50%; width: 0;
    border-left: 2px dashed var(--linie-hell);
  }
  .feld { position: relative; display: grid; grid-template-columns: 1fr 56px 1fr; align-items: center; }
  .feld-nr {
    grid-column: 2; justify-self: center; z-index: 1; display: grid; place-items: center;
    width: 44px; height: 44px; border-radius: 50%; border: 2px solid var(--eis); background: var(--nacht);
    font: 600 0.9rem var(--f-mono); color: var(--eis);
  }
  .feld-karte {
    grid-row: 1; grid-column: 1; border: 1px solid var(--linie); border-radius: var(--radius);
    background: var(--tiefe); padding: 16px 18px;
  }
  .feld:nth-child(even) .feld-karte { grid-column: 3; }
  .feld-karte h3 { font-size: 1.15rem; }
  .feld-karte p { color: var(--text-ruhig); margin-top: 6px; font-size: max(0.95rem, var(--min-karte)); }
  .feld-tags { list-style: none; margin: 10px 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .feld-tags li {
    font: 500 0.75rem var(--f-mono); text-transform: uppercase; letter-spacing: 0.04em;
    padding: 3px 8px; border-radius: 4px; border: 1px solid var(--linie-hell); color: var(--eis);
  }
  .feld-link { display: inline-block; margin-top: 10px; font-weight: 600; font-size: 0.92rem; text-decoration: none; }
  .feld-link:hover { text-decoration: underline; }
  .felder-grenze { margin-top: 24px; color: var(--text-ruhig); max-width: 70ch; }
  .felder-grenze strong { color: var(--signal); }
  @media (max-width: 760px) {
    .felder::before { left: 22px; }
    .feld { grid-template-columns: 44px 1fr; gap: 12px; align-items: start; }
    .feld-nr { grid-column: 1; grid-row: 1; }
    .feld-karte, .feld:nth-child(even) .feld-karte { grid-column: 2; }
  }
</style>
