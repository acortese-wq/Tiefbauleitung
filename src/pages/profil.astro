---
import Basis from '../layouts/Basis.astro';
import Seitenkopf from '../components/Seitenkopf.astro';
import { person, werdegang, ausbildung, weiterbildung, sprachen, nebenamt, zeugnisse, berufsprofil } from '../data/person';
import { personJsonLd, breadcrumbJsonLd } from '../lib/seo';

const site = Astro.site!;
const werte = [
  { titel: 'Belegen statt behaupten', text: 'Ob Nachtrag, Abrechnung oder KI-Ergebnis: Jede Aussage braucht eine nachvollziehbare Grundlage.' },
  { titel: 'Beide Seiten verstehen', text: 'Ich habe im Ingenieurbüro, beim Kanton und beim Netzbetreiber gearbeitet. Das hilft, Interessen auszugleichen.' },
  { titel: 'Einfach vor gross', text: 'Ein Werkzeug, das täglich genutzt wird, bringt mehr als eine grosse Lösung, die niemand öffnet.' },
  { titel: 'Wissen weitergeben', text: 'Seit 2000 Prüfungsexperte, früher Lehrlingsbetreuer: Nachwuchs und Team sollen von Erfahrung profitieren.' },
];
---
<Basis
  title="Profil"
  description="Werdegang von Alessandro Cortese: über 30 Jahre Tiefbau, Bauherrenvertreter im Glasfaserausbau, Tiefbauamt Graubünden und Zertifikat KI-Professional."
  typ="profile"
  jsonLd={[personJsonLd(site), breadcrumbJsonLd([{ name: 'Start', url: site.href }, { name: 'Profil', url: new URL('/profil/', site).href }])]}
>
  <Seitenkopf
    titel="Profil"
    pos="Pos. 100"
    lead="Über 30 Jahre Tiefbau aus drei Blickwinkeln: Ingenieurbüro, Kanton und Netzbetreiber. Heute verbinde ich diese Erfahrung mit digitalen Werkzeugen und KI-Agenten."
    krumen={[{ name: 'Profil' }]}
  />

  <section class="abschnitt">
    <div class="wrap profil-intro">
      <picture>
        <source srcset="/bilder/portrait.webp" type="image/webp" />
        <img src="/bilder/portrait.jpg" alt="Porträt von Alessandro Cortese" width="600" height="600" decoding="async" />
      </picture>
      <div class="prosa">
        <p>
          Ich bin {person.beruf} und arbeite als {person.rolle} bei der {person.arbeitgeber}. Ich lebe in {person.ort}. Mein Weg begann 1994 mit der
          Lehre als Tiefbauzeichner. Es folgten die Projektierung von Hauptstrassen beim Tiefbauamt Graubünden,
          Projekt- und Bauleitungen im Strassen-, Bahn- und Siedlungswasserbau bei zwei Ingenieurbüros und ab 2013
          wieder der Kanton: zuerst als Bauleiter, ab 2021 als Leiter Projektierung und Bau im Bezirk 1 Chur.
        </p>
        <p>
          Seit April 2025 begleite ich FTTH- und Netzbauprojekte als Bauherrenvertreter, von der Ausschreibung bis
          zur Bauabnahme. Mein Anspruch: Es wird gebaut, was vereinbart wurde, in Qualität, Kosten und Terminen.
        </p>
        <p>
          Parallel habe ich den Zertifikatslehrgang KI-Professional (KI-Agent) an der HSO absolviert, abgeschlossen im
          Juli 2026. Unsere Abschlussarbeit, der Workflow-Agent
          <a href="/projekte/trennungskompass/">«Trennungskompass»</a>, wurde als stärkste Arbeit im Kurs beurteilt. Seither
          entwickle ich Werkzeuge, die Prüf- und Rechenarbeit im Tiefbau beschleunigen (<a href="/projekte/#werkzeugkasten">Werkzeugkasten</a>), und privat Lern-Apps für meine Kinder.
        </p>
      </div>
    </div>
  </section>

  <section class="abschnitt berufsprofil" id="berufsprofil" aria-labelledby="berufsprofil-titel">
    <div class="wrap">
      <div class="abschnitt-kopf">
        <span class="pos">Kurzprofil</span>
        <h2 id="berufsprofil-titel">Berufliches Profil</h2>
      </div>
      <div class="bp-raster">
        <div class="bp-text">
          {berufsprofil.absaetze.map((a) => <p>{a}</p>)}
        </div>
        <div class="bp-listen">
          <h3 class="liste-titel">Fachliche Schwerpunkte</h3>
          <ul class="bp-schwerpunkte">
            {berufsprofil.schwerpunkte.map((s) => (
              <li>
                <a href={s.href}>
                  <strong>{s.titel}</strong>
                  <span>{s.nutzen}</span>
                  <span class="bp-pfeil" aria-hidden="true">→</span>
                </a>
              </li>
            ))}
          </ul>
          <h3 class="liste-titel">Arbeitsweise</h3>
          <ul class="bp-arbeitsweise">
            {berufsprofil.arbeitsweise.map((a) => <li>{a}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="abschnitt band-hell" aria-labelledby="werte-titel">
    <div class="wrap">
      <div class="abschnitt-kopf">
        <span class="pos">Arbeitsweise</span>
        <h2 id="werte-titel">Wie ich arbeite</h2>
      </div>
      <div class="raster-4">
        {werte.map((w) => (
          <article class="karte"><h3>{w.titel}</h3><p>{w.text}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="werdegang-titel">
    <div class="wrap">
      <div class="abschnitt-kopf">
        <span class="pos">Werdegang</span>
        <h2 id="werdegang-titel">Berufliche Stationen</h2>
        <p>Von der Lehre als Tiefbauzeichner bis zur Bauherrenvertretung im Glasfaserausbau. Jede Station ist durch Lebenslauf und Arbeitszeugnisse belegt.</p>
      </div>
      <figure class="werdegang-bild" id="werdegang-grafik">
        <a href="/bilder/werdegang.jpg" class="werdegang-zoom">
          <picture>
            <source type="image/webp" srcset="/bilder/werdegang-1000.webp 1000w, /bilder/werdegang-1983.webp 1983w" sizes="(min-width: 1180px) 1128px, calc(100vw - 32px)" />
            <img src="/bilder/werdegang.jpg" width="1983" height="793" loading="lazy" decoding="async" alt="Infografik «Vom Tiefbauzeichner zum Bauingenieur – Erfahrung trifft KI»: 1994 Lehre als Tiefbauzeichner, Projektierung von Hauptstrassen, Projektleitung in zwei Ingenieurbüros, Führung eines Teams von vier Bauleitern, seit 2025 Bauherrenvertreter im Glasfaserausbau, seit 2000 Prüfungsexperte für Bauzeichnerinnen und Bauzeichner, Zertifikat KI-Professional (KI-Agent) der HSO." />
          </picture>
        </a>
        <figcaption>Der Weg im Überblick. Die Einzelheiten zu jeder Station folgen unten. <span>KI-generierte Illustration · <a href="/bilder/werdegang.jpg">Grafik in voller Grösse öffnen</a></span></figcaption>
      </figure>
      <ol class="zeitachse">
        {werdegang.map((s) => (
          <li>
            <span class="zeit">{s.von} – {s.bis}</span>
            <div>
              <h3>{s.titel}</h3>
              <p class="org">{s.organisation}</p>
              <ul>{s.punkte.map((p) => <li>{p}</li>)}</ul>
            </div>
          </li>
        ))}
        <li>
          <span class="zeit">1994 – 1999</span>
          <div><h3>Lehre als Tiefbauzeichner</h3><p class="org">Anschliessend Technische Berufsmatura</p></div>
        </li>
      </ol>
      <aside class="karte nebenamt">
        <span class="label label-eis">Nebenamtlich seit {nebenamt.seit}</span>
        <h3>{nebenamt.titel}</h3>
        <p>Abnahme von Qualifikationsverfahren und Förderung des Berufsnachwuchses.</p>
      </aside>
    </div>
  </section>

  <section class="abschnitt band-hell" aria-labelledby="bildung-titel">
    <div class="wrap">
      <div class="abschnitt-kopf">
        <span class="pos">Aus- und Weiterbildung</span>
        <h2 id="bildung-titel">Nachweisbare Aus- und Weiterbildungen</h2>
      </div>
      <div class="raster-2">
        <div>
          <h3 class="liste-titel">Ausbildung</h3>
          <dl class="tabelle">
            {ausbildung.map((a) => (
              <div><dt>{a.zeit}</dt><dd>{a.titel}{a.hinweis && <small>{a.hinweis}</small>}</dd></div>
            ))}
          </dl>
          <h3 class="liste-titel">Sprachen</h3>
          <dl class="tabelle">
            {sprachen.map((s) => <div><dt>{s.sprache}</dt><dd>{s.niveau}</dd></div>)}
          </dl>
        </div>
        <div>
          <h3 class="liste-titel">Weiterbildung</h3>
          <dl class="tabelle">
            {weiterbildung.map((w) => (
              <div><dt>{w.zeit}</dt><dd>{w.titel}{'hinweis' in w && w.hinweis && <small>{w.hinweis}</small>}</dd></div>
            ))}
          </dl>
        </div>
      </div>
    </div>
  </section>

  <section class="abschnitt" aria-labelledby="zeugnis-titel">
    <div class="wrap">
      <div class="abschnitt-kopf">
        <span class="pos">Zeugnisse</span>
        <h2 id="zeugnis-titel">Wörtliche Auszüge aus Arbeitszeugnissen</h2>
        <p>Vollständige Zeugnisse auf Anfrage.</p>
      </div>
      <div class="raster-2">
        {zeugnisse.map((z) => (
          <figure class="karte zeugnis">
            <blockquote><p>«{z.text}»</p></blockquote>
            <figcaption>{z.quelle} · {z.art}</figcaption>
          </figure>
        ))}
      </div>
    </div>
  </section>
</Basis>

<style>
  .werdegang-bild { margin: 0 0 clamp(28px, 4vw, 44px); }
  .werdegang-bild img { display: block; width: 100%; height: auto; border-radius: var(--radius); border: 1px solid var(--linie); }
  .werdegang-zoom { display: block; cursor: zoom-in; }
  .werdegang-zoom:focus-visible { outline: 2px solid var(--eis); outline-offset: 3px; }
  .werdegang-bild figcaption { margin-top: 10px; color: var(--text-ruhig); font-size: 0.95rem; }
  .werdegang-bild figcaption span { display: block; margin-top: 4px; font: 0.78rem var(--f-mono); }
  .profil-intro { display: grid; grid-template-columns: 260px minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  .profil-intro img { width: 100%; height: auto; border-radius: var(--radius); border: 1px solid var(--linie-hell); display: block; }
  .zeitachse { list-style: none; margin: 0; padding: 0 0 0 28px; position: relative; display: grid; gap: 34px; }
  .zeitachse::before { content: ''; position: absolute; left: 6px; top: 8px; bottom: 8px; width: 2px; background: var(--linie-hell); }
  .zeitachse > li { position: relative; display: grid; grid-template-columns: 170px minmax(0, 1fr); gap: 24px; }
  .zeitachse > li::before { content: ''; position: absolute; left: -28px; top: 6px; width: 14px; height: 14px; border-radius: 50%; background: var(--nacht); border: 2px solid var(--eis); }
  .zeitachse > li:first-child::before { background: var(--eis); }
  .zeit { font-family: var(--f-mono); font-size: 0.82rem; color: var(--eis); padding-top: 3px; }
  .zeitachse h3 { font-size: 1.5rem; }
  .org { color: var(--text-ruhig); font-weight: 600; margin-top: 4px; }
  .zeitachse ul { margin: 10px 0 0; padding-left: 1.1em; color: var(--text-ruhig); display: grid; gap: 4px; max-width: 70ch; }
  .zeitachse ul li::marker { color: var(--eis); }
  .nebenamt { margin-top: 36px; max-width: 620px; }
  .liste-titel { font-size: 1.4rem; margin: 0 0 10px; }
  .berufsprofil { border-top: 1px solid var(--linie); }
  .bp-raster { display: grid; grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 64px); align-items: start; }
  .bp-text { display: grid; gap: 14px; }
  .bp-text p { margin: 0; color: var(--text-ruhig); font-size: 1.06rem; line-height: 1.65; }
  .bp-text p:first-child { color: var(--text); font-size: var(--s-1); line-height: 1.5; }
  .bp-schwerpunkte { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(220px, 1fr)); gap: 10px; }
  .bp-schwerpunkte a {
    position: relative; display: grid; gap: 4px; align-content: start; height: 100%; padding: 12px 34px 12px 14px; min-height: 44px;
    border: 1px solid var(--linie-hell); border-radius: var(--radius); background: var(--tiefe);
    color: var(--text); text-decoration: none; transition: border-color .2s, transform .2s;
  }
  .bp-schwerpunkte a:hover { border-color: var(--eis); transform: translateY(-1px); }
  .bp-schwerpunkte a:focus-visible { outline: 2px solid var(--eis); outline-offset: 2px; }
  .bp-schwerpunkte strong { font-weight: 600; font-size: 0.98rem; line-height: 1.3; }
  .bp-schwerpunkte span { color: var(--text-ruhig); font-size: 0.86rem; line-height: 1.4; }
  .bp-schwerpunkte .bp-pfeil { position: absolute; right: 12px; top: 12px; color: var(--eis); font-family: var(--f-mono); font-size: 1rem; }
  @media (max-width: 520px) { .bp-schwerpunkte { grid-template-columns: 1fr 1fr; } .bp-schwerpunkte span:not(.bp-pfeil) { font-size: 0.8rem; } }
  @media (prefers-reduced-motion: reduce) { .bp-schwerpunkte a { transition: none; } .bp-schwerpunkte a:hover { transform: none; } }
  .bp-arbeitsweise { list-style: none; margin: 0; padding: 0; display: grid; gap: 8px; }
  .bp-arbeitsweise li { position: relative; padding-left: 22px; color: var(--text); }
  .bp-arbeitsweise li::before { content: ''; position: absolute; left: 2px; top: 0.6em; width: 10px; height: 2px; background: var(--eis); }
  @media (max-width: 860px) { .bp-raster { grid-template-columns: 1fr; } }
  .liste-titel:not(:first-child) { margin-top: 28px; }
  .tabelle { margin: 0; border-top: 1px solid var(--papier-linie); }
  .tabelle div { display: grid; grid-template-columns: 110px minmax(0, 1fr); gap: 14px; padding: 9px 0; border-bottom: 1px solid var(--papier-linie); }
  .tabelle dt { font-family: var(--f-mono); font-size: 0.8rem; color: var(--papier-akzent); padding-top: 2px; }
  .tabelle dd { margin: 0; }
  .tabelle small { display: block; color: var(--papier-ruhig); font-size: 0.9rem; }
  .zeugnis { margin: 0; }
  .zeugnis blockquote { margin: 0; font-size: 1.12rem; line-height: 1.5; }
  .zeugnis figcaption { font-family: var(--f-mono); font-size: 0.76rem; color: var(--text-ruhig); }
  @media (max-width: 760px) {
    .profil-intro { grid-template-columns: 1fr; }
    .profil-intro picture { max-width: 180px; }
    .zeitachse > li { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
