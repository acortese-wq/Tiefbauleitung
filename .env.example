# Beispielkonfiguration – keine echten Werte eintragen und nie committen.
# Kopieren nach .env und lokal bzw. beim Hoster ausfüllen.

# Öffentliche Adresse der Webseite (für Canonical-URLs, Sitemap, Open Graph).
# Bis die Domain feststeht, bleibt der Platzhalter aktiv.
SITE_URL=https://www.example.ch

# Server
HOST=0.0.0.0
PORT=8080

# Entwürfe von Fachbeiträgen im Build anzeigen (nur für Vorschau, nie in Produktion).
SHOW_DRAFTS=false

# ---------- Kontaktformular (standardmässig AUS) ----------
# Aktuell läuft der Kontakt über LinkedIn. Das Formular wird erst angezeigt,
# wenn PUBLIC_CONTACT_FORM=true beim Build gesetzt ist UND der Versand konfiguriert ist.
PUBLIC_CONTACT_FORM=false

# Geheimer Schlüssel für das Formular-Token (mind. 32 zufällige Zeichen).
# Erzeugen: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CONTACT_SECRET=

# SMTP-Versand (z. B. Infomaniak Mail). Empfängeradresse wird nirgends angezeigt.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
CONTACT_TO=
CONTACT_FROM=
