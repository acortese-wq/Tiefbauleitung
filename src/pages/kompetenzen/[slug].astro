---
import { render, type CollectionEntry } from 'astro:content';
import Basis from '../../layouts/Basis.astro';
import Seitenkopf from '../../components/Seitenkopf.astro';
import Referenzliste from '../../components/Referenzliste.astro';
import Referenzbilder from '../../components/Referenzbilder.astro';
import ProjektKarte from '../../components/ProjektKarte.astro';
import Werkzeugkasten from '../../components/Werkzeugkasten.astro';
import { werkzeuge } from '../../data/werkzeuge';
import { alleKompetenzen, sichtbareProjekte } from '../../lib/content';
import { breadcrumbJsonLd } from '../../lib/seo';
import TiefbauInfrastruktur from '../../components/illustrationen/TiefbauInfrastruktur.astro';
import NetzinfrastrukturLeitungsbau from '../../components/illustrationen/NetzinfrastrukturLeitungsbau.astro';
import DigitalisierungProzesse from '../../components/illustrationen/DigitalisierungProzesse.astro';
import KiAgenten from '../../components/illustrationen/KiAgenten.astro';

// Planzeichnung im Seitenkopf, solange kein Kopfbild (bild im Frontmatter) gesetzt ist
const zeichnungen: Record<string, typeof TiefbauInfrastruktur> = {
  'tiefbau-infrastruktur': TiefbauInfrastruktur,
  'netzinfrastruktur-leitungsbau': NetzinfrastrukturLeitungsbau,
  'digitalisierung-prozesse': DigitalisierungProzesse,
  'ki-agenten': KiAgenten,
};

export async function getStaticPaths() {
  const kompetenzen = await alleKompetenzen();
  return kompetenzen.map((k) => ({ params: { slug: k.id }, props: { kompetenz: k, alle: kompetenzen } }));
}

interface Props { kompetenz: CollectionEntry<'kompetenzen'>; alle: CollectionEntry<'kompetenzen'>[]; }
const { kompetenz, alle } = Astro.props;
const { Content } = await render(kompetenz);
const d = kompetenz.data;
const projekte = (await sichtbareProjekte()).filter((p) => p.data.kompetenzen.includes(kompetenz.id));
const weitere = alle.filter((k) => k.id !== kompetenz.id);
const Zeichnung = zeichnungen[kompetenz.id];
const hatWerkzeuge = werkzeuge.some((w) => w.kompetenzen.includes(kompetenz.id));
const site = Astro.site!;
const url = new URL(`/kompetenzen/${kompetenz.id}/`, site).href;
---
<Basis
  title={d.title}
  description={d.kurz}
  jsonLd={[breadcrumbJsonLd([
    { name: 'Start', url: site.href },
    { name: 'Kompetenzen', url: new URL('/kompetenzen/', site).href },
    { name: d.title, url },
  ])]}
>
  <Seitenkopf
    titel={d.title}
    pos={`${d.bereich} · ${d.seit}`}
    lead={d.kurz}
    krumen={[{ name: 'Kompetenzen', href: '/kompetenzen/' }, { name: d.title }]}
    bild={d.bild ? { ordner: 'kompetenzen', name: d.bild, alt: d.bildAlt!, hinweis: d.bildHinweis } : undefined}
  >
    {Zeichnung && <Zeichnung slot="bild" />}
    <div class="chips">{d.grundlagen.map((g) => <span class="chip">{g}</span>)}</div>
  </Seitenkopf>

  <section class="abschnitt">
    <div class="wrap">
      <article class="prosa" data-pagefind-body data-lesefortschritt>
        <Content />
      </article>
    </div>
  </section>

  {hatWerkzeuge && (
    <section class="abschnitt" aria-labelledby="wk-titel">
      <div class="wrap">
        <div class="abschnitt-kopf">
          <span class="pos">Werkzeugkasten</span>
          <h2 id="wk-titel">Eigene Werkzeuge in diesem Feld</h2>
        </div>
        <Werkzeugkasten kompetenz={kompetenz.id} />
        <p class="wk-alle"><a href="/projekte/#werkzeugkasten">Alle Werkzeuge ansehen <span class="pfeil" aria-hidden="true">→</span></a></p>
      </div>
    </section>
  )}

  {projekte.length > 0 && (
    <section class="abschnitt band-hell" aria-labelledby="bsp-titel">
      <div class="wrap">
        <div class="abschnitt-kopf"><span class="pos">Beispiele</span><h2 id="bsp-titel">Passende Fallstudien</h2></div>
        <div class="raster-3">{projekte.map((p) => <ProjektKarte projekt={p} />)}</div>
      </div>
    </section>
  )}

  {d.referenzFilter && (
    <section class="abschnitt" aria-labelledby="ref-titel">
      <div class="wrap">
        <div class="abschnitt-kopf">
          <span class="pos">Referenzen</span>
          <h2 id="ref-titel">Belegte Referenzprojekte</h2>
          <p>Aus Lebenslauf und Arbeitszeugnissen. Rolle jeweils wie dort angegeben.</p>
        </div>
        <Referenzbilder filter={d.referenzFilter} />
        <Referenzliste filter={d.referenzFilter} kompakt />
      </div>
    </section>
  )}

  <section class="abschnitt" aria-labelledby="weitere-titel">
    <div class="wrap">
      <div class="abschnitt-kopf"><span class="pos">Weitere Felder</span><h2 id="weitere-titel">Verwandte Kompetenzen</h2></div>
      <div class="raster-3">
        {weitere.map((k) => (
          <a class="karte" href={`/kompetenzen/${k.id}/`}>
            <span class="label label-eis">{k.data.bereich}</span>
            <h3>{k.data.title}</h3>
            <p>{k.data.kurz}</p>
          </a>
        ))}
      </div>
    </div>
  </section>
</Basis>

<style>
  .wk-alle { margin-top: 20px; font-weight: 600; }
  .wk-alle a { display: inline-flex; align-items: center; min-height: 44px; }
</style>
